{
  "name": "firetv-webview-probe-vega",
  "version": "0.0.1",
  "private": true,
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rm -rf node_modules buildinfo.json dist build",
    "start": "react-native start",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "build:release": "react-native build-vega --build-type Release",
    "build:debug": "react-native build-vega --build-type Debug"
  },
  "dependencies": {
    "@amazon-devices/react-native-kepler": "^4.0.0",
    "@amazon-devices/webview": "^4.0.0",
    "react": "19.2.0",
    "react-native": "0.83.0"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@amazon-devices/kepler-cli-platform": "^0",
    "@amazon-devices/eslint-plugin-kepler": "^0.1.4",
    "@react-native-community/cli": "20.0.0",
    "@react-native/babel-preset": "0.83.0",
    "@react-native/eslint-config": "0.83.0",
    "@react-native/metro-config": "0.83.0",
    "@types/react": "^19.2.0",
    "@typescript-eslint/eslint-plugin": "^6.5.0",
    "eslint": "^8.57.1",
    "jsonc-eslint-parser": "^2.4.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^2.8.8",
    "typescript": "5.8.3"
  },
  "kepler": {
    "projectType": "application",
    "appName": "firetvwebviewprobe",
    "targets": [
      "tv"
    ]
  },
  "overrides": {
    "react": "19.2.0",
    "react-native": "0.83.0"
  },
  "description": "Vega OS shell for the Fire TV WebView probe. Build with npm run vega from the repository root.",
  "license": "MIT"
}
